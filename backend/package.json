{
  "name": "expenses",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"{src,scripts,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,scripts,test}/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,scripts,migrations,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,scripts,migrations,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand --ci",
    "test:watch": "jest --watch --runInBand",
    "test:cov": "jest --coverage --runInBand --ci",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:drop": "npx typeorm schema:drop -d datasource.js",
    "db:migrate": "ts-node --transpile-only scripts/migrate.ts",
    "db:migrate:docker_prod": "node dist/scripts/migrate.js",
    "db:migrate:new": "typeorm migration:generate -p -d datasource.js ./migrations/default/init",
    "db:migrate:empty": "npx typeorm migration:create"
  },
  "dependencies": {
    "@fastify/otel": "0.21.0",
    "@fastify/static": "10.1.3",
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@nestjs/axios": "12.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/microservices": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@nestjs/schedule": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/terminus": "12.0.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "async-retry": "1.3.3",
    "axios": "1.20.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "fastify-plugin": "6.0.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "tsconfig-paths": "4.2.0",
    "typeorm": "1.1.1",
    "typeorm-naming-strategies": "4.1.0",
    "ulid": "3.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/async-retry": "1.4.9",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.25",
    "@types/node": "26.5.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "fastify": "5.12.3",
    "globals": "17.12.0",
    "jest": "30.5.1",
    "lodash": "4.18.1",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "fastify": "$fastify"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": "\\.(test|spec)\\.ts$",
    "transform": {"^.+\\.(t|j)s$": "ts-jest"},
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/__tests__/**",
      "!**/*.spec.ts",
      "!**/*.test.ts",
      "!**/index.ts",
      "!main.ts",
      "!otel.ts",
      "!test-support/**"
    ],
    "coverageReporters": ["text-summary", "lcov"],
    "restoreMocks": true,
    "clearMocks": true,
    "testTimeout": 20000,
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "#api/(.*)": "<rootDir>/api/$1",
      "#domain/(.*)": "<rootDir>/domain/$1",
      "#usecases/(.*)": "<rootDir>/usecases/$1",
      "#frameworks/(.*)": "<rootDir>/frameworks/$1",
      "#packages/(.*)": "<rootDir>/packages/$1",
      "#test-support/(.*)": "<rootDir>/test-support/$1"
    }
  }
}
