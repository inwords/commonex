      {
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "postgres-ds"
        },
        "description": "Counters are cumulative since stats_reset. Buffer cache hits exclude OS cache. Database size is not free disk space.",
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "cellOptions": {
                "type": "auto"
              }
            },
            "mappings": []
          },
          "overrides": []
        },
        "gridPos": {
          "h": 9,
          "w": 24,
          "x": 0,
          "y": 32
        },
        "id": 9,
        "options": {
          "cellHeight": "sm",
          "footer": {
            "show": false
          },
          "showHeader": true
        },
        "targets": [
          {
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "postgres-ds"
            },
            "format": "table",
            "rawQuery": true,
            "rawSql": "SELECT current_database() AS database, current_setting('max_connections')::int AS max_connections, (SELECT COUNT(*) FROM pg_stat_activity WHERE backend_type = 'client backend') AS cluster_client_connections, numbackends AS database_connections, pg_database_size(datid) AS database_bytes, ROUND(100.0 * blks_hit / NULLIF(blks_hit + blks_read, 0), 2) AS cache_hit_percent_since_reset, deadlocks AS deadlocks_since_reset, temp_bytes AS temp_bytes_since_reset, stats_reset FROM pg_stat_database WHERE datname = current_database()",
            "refId": "A"
          }
        ],
        "title": "Connections \u0026 Database Health — current snapshot",
        "type": "table"
      },
