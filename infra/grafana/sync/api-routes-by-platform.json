          "type": "dashboard"
        }
      ]
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "links": [],
    "panels": [
      {
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "bf05veuz39r0ge"
        },
        "description": "Completed backend requests per second, grouped by client platform, HTTP method, and route template.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisBorderShow": false,
              "axisCenteredZero": false,
              "axisColorMode": "text",
              "axisLabel": "",
              "axisPlacement": "auto",
              "barAlignment": 0,
              "barWidthFactor": 0.6,
              "drawStyle": "line",
              "fillOpacity": 8,
              "gradientMode": "none",
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "viz": false
              },
              "insertNulls": false,
              "lineInterpolation": "linear",
              "lineStyle": {
                "fill": "solid"
              },
              "lineWidth": 1,
              "pointSize": 3,
              "scaleDistribution": {
                "type": "linear"
              },
              "showPoints": "never",
              "showValues": false,
              "spanNulls": false,
              "stacking": {
                "group": "A",
                "mode": "none"
              },
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": 0
                }
              ]
            },
            "unit": "reqps"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 10,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "options": {
          "legend": {
            "calcs": [
              "mean",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "hideZeros": false,
            "mode": "multi",
            "sort": "desc"
          }
        },
        "pluginVersion": "13.2.1",
        "targets": [
          {
            "editorMode": "code",
            "expr": "sum by(commonex.client.platform, http.request.method, http.route) (\n  increase_pure(http.server.request.duration_count{\n    commonex.client.platform=~\"${platform:regex}\",\n    http.request.method=~\"${method:regex}\",\n    http.route=~\"${route:regex}\"\n  }[$__rate_interval])\n) / $__rate_interval",
            "format": "time_series",
            "legendFormat": "{{commonex.client.platform}} · {{http.request.method}} {{http.route}}",
            "range": true,
            "refId": "A"
          }
        ],
        "title": "API request rate by platform and route",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "bf05veuz39r0ge"
        },
        "description": "Backend request-duration percentiles, grouped by client platform, HTTP method, and route template.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisBorderShow": false,
              "axisCenteredZero": false,
              "axisColorMode": "text",
              "axisLabel": "",
              "axisPlacement": "auto",
              "barAlignment": 0,
              "barWidthFactor": 0.6,
              "drawStyle": "line",
              "fillOpacity": 0,
              "gradientMode": "none",
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "viz": false
              },
              "insertNulls": false,
              "lineInterpolation": "linear",
              "lineStyle": {
                "fill": "solid"
              },
              "lineWidth": 2,
              "pointSize": 3,
              "scaleDistribution": {
                "type": "linear"
              },
              "showPoints": "never",
              "showValues": false,
              "spanNulls": false,
              "stacking": {
                "group": "A",
                "mode": "none"
              },
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "red",
                  "value": 1000
                }
              ]
            },
            "unit": "ms"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 12,
          "w": 24,
          "x": 0,
          "y": 10
        },
        "id": 2,
        "options": {
          "legend": {
            "calcs": [
              "lastNotNull",
              "max"
            ],
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "hideZeros": false,
            "mode": "multi",
            "sort": "desc"
          }
        },
        "pluginVersion": "13.2.1",
        "targets": [
          {
            "editorMode": "code",
            "expr": "1000 * histogram_quantile(0.50,\n  sum by(le, commonex.client.platform, http.request.method, http.route) (\n    increase_pure(http.server.request.duration_bucket{\n      commonex.client.platform=~\"${platform:regex}\",\n      http.request.method=~\"${method:regex}\",\n      http.route=~\"${route:regex}\"\n    }[$__rate_interval])\n  )\n)",
            "format": "time_series",
            "legendFormat": "P50 · {{commonex.client.platform}} · {{http.request.method}} {{http.route}}",
            "range": true,
            "refId": "A"
          },
          {
            "editorMode": "code",
            "expr": "1000 * histogram_quantile(0.95,\n  sum by(le, commonex.client.platform, http.request.method, http.route) (\n    increase_pure(http.server.request.duration_bucket{\n      commonex.client.platform=~\"${platform:regex}\",\n      http.request.method=~\"${method:regex}\",\n      http.route=~\"${route:regex}\"\n    }[$__rate_interval])\n  )\n)",
            "format": "time_series",
            "legendFormat": "P95 · {{commonex.client.platform}} · {{http.request.method}} {{http.route}}",
            "range": true,
            "refId": "B"
          },
          {
            "editorMode": "code",
            "expr": "1000 * histogram_quantile(0.99,\n  sum by(le, commonex.client.platform, http.request.method, http.route) (\n    increase_pure(http.server.request.duration_bucket{\n      commonex.client.platform=~\"${platform:regex}\",\n      http.request.method=~\"${method:regex}\",\n      http.route=~\"${route:regex}\"\n    }[$__rate_interval])\n  )\n)",
            "format": "time_series",
            "legendFormat": "P99 · {{commonex.client.platform}} · {{http.request.method}} {{http.route}}",
            "range": true,
            "refId": "C"
          }
        ],
        "title": "API latency percentiles by platform and route",
        "type": "timeseries"
      }
    ],
    "preload": false,
    "schemaVersion": 42,
    "tags": [
      "api",
      "backend",
      "platform",
      "latency"
