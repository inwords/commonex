[Unit]
Description=Publish CommonEx certificate health to VictoriaMetrics
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/commonex/certificates/current/renew.py monitor
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
