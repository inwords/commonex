[Unit]
Description=Renew CommonEx certificate using Yandex Cloud DNS
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/commonex/certificates/current/renew.py renew
TimeoutStartSec=40min
ExecStopPost=-/usr/bin/python3 -B /opt/commonex/certificates/current/renew.py cleanup
NoNewPrivileges=true
PrivateTmp=true
